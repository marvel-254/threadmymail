{
  "expo": {
    "name": "ThreadMyMail",
    "slug": "threadmymail",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "threadmymail",
    "backgroundColor": "#0B1326",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threadmymail.app"
    },
    "android": {
      "package": "com.threadmymail.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0B1326",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1326",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "react-native-mail-engine",
      "./plugins/withMailEngineLink",
      "./plugins/withAndroidReleaseSigning",
      "expo-video",
      "./plugins/withAndroidPackagingPickFirsts",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Millo",
              "label": "Millo",
              "description": "Unread and needs-your-eye counts, one-tap triage, and the kill switch.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withKillSwitchTile",
      "expo-splash-screen"
    ]
  }
}
