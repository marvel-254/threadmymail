# Local development secrets. Copy to .dev.vars and fill in. NEVER commit .dev.vars.
# Wrangler loads .dev.vars automatically for `wrangler dev`.

# Neon direct connection (used by migrations, not by the Worker at runtime —
# the Worker must go through Hyperdrive. See docs/ARCHITECTURE.md §4.)
DATABASE_URL="postgresql://neondb_owner:REPLACE@ep-rapid-night-b2wvodb7.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon pooled connection (for local scripts / psql)
DATABASE_URL_POOLED="postgresql://neondb_owner:REPLACE@ep-rapid-night-b2wvodb7-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Google OAuth — see docs/GOOGLE_OAUTH.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8787/auth/google/callback"

# BYOK model access
OPENROUTER_API_KEY=""

# 32-byte key, base64. Encrypts oauth_tokens and plugin_credentials.
# Generate:  openssl rand -base64 32
ENCRYPTION_KEY=""

# Session/JWT signing
SESSION_SECRET=""

# Local dev only: wrangler needs a real Postgres string to emulate Hyperdrive.
# Point these at a local Postgres, or at the same database with sslmode=disable.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB="postgresql://user:pass@localhost:5432/neondb"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_FRESH="postgresql://user:pass@localhost:5432/neondb"
