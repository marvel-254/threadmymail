{
  "name": "threadmymail-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ThreadMyMail agent runtime: API, Durable Object chat agent, cron heartbeat, durable workflows.",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:remote": "bash scripts/dev.sh --remote",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "spike": "node scripts/run-spike.mjs",
    "db:push": "node scripts/db-push.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.14",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd@1.20260926.1": true
  }
}
